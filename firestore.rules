// LISTO — Règles de sécurité de la base Firestore (compteur anonyme + sauvegarde automatique des comptes)
// (à coller dans la console Firebase du projet LISTO : Firestore Database > Règles > Publier).
// compteur/{lundi de la semaine, AAAA-MM-JJ} = { ios, android, autre, nouveaux, installes }
// Tout le monde (sans compte) peut seulement AJOUTER 1 : à exactement UN type de téléphone, et au plus 1 à
// « nouveaux » et à « installes ». Aucun autre champ, aucune lecture depuis l'appli, aucune suppression.
// Lecture : seulement le compte du créateur (fiche admins/{son uid}, créée à la main dans la console), pour l'écran
// « Compteur » caché de l'appli (v0.15.0). La console Firebase, elle, voit tout.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ecart(n, a, k) {
      return n.get(k, 0) - a.get(k, 0);
    }
    function plusUn(n, a) {
      return n.keys().hasOnly(['ios', 'android', 'autre', 'nouveaux', 'installes'])
        && n.get('ios', 0) is int && n.get('android', 0) is int && n.get('autre', 0) is int
        && n.get('nouveaux', 0) is int && n.get('installes', 0) is int
        && ecart(n, a, 'ios') in [0, 1] && ecart(n, a, 'android') in [0, 1] && ecart(n, a, 'autre') in [0, 1]
        && ecart(n, a, 'ios') + ecart(n, a, 'android') + ecart(n, a, 'autre') == 1
        && ecart(n, a, 'nouveaux') in [0, 1] && ecart(n, a, 'installes') in [0, 1];
    }
    match /compteur/{semaine} {
      allow create: if semaine.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$') && plusUn(request.resource.data, {});
      allow update: if semaine.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$') && plusUn(request.resource.data, resource.data);
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow delete: if false;
    }
    // Fiche « créateur » : chacun peut seulement savoir si SA propre fiche existe. Création à la main dans la console.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Sauvegarde automatique (v0.16.0) : users/{uid}/sauvegarde/derniere = { j: texte, t: date, v: 1 }.
    // Chaque compte ne peut lire, écrire et effacer QUE sa propre sauvegarde. Taille limitée.
    match /users/{uid}/sauvegarde/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && doc == 'derniere';
      allow create, update: if request.auth != null && request.auth.uid == uid && doc == 'derniere'
        && request.resource.data.keys().hasOnly(['j', 't', 'v'])
        && request.resource.data.j is string && request.resource.data.j.size() <= 1000000
        && request.resource.data.t is int && request.resource.data.v == 1;
    }
    // tout le reste est interdit
    match /{autre=**} {
      allow read, write: if false;
    }
  }
}
